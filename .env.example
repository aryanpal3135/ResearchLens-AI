# ==============================================================================
# ResearchLens AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit the real .env file with secrets into version control!

# ------------------------------------------------------------------------------
# 1. Microsoft Foundry / Azure OpenAI Services
# ------------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Model Deployments configured in Microsoft Foundry / Azure AI Studio
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Microsoft Foundry Project & Agent SDK Settings (Optional/Advanced)
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com/api/projects/<project-id>
FOUNDRY_RESEARCH_AGENT_NAME=researchlens-agent
FOUNDRY_CHAT_AGENT_NAME=researchlens-chat-agent

# Azure Resource Identification (optional, for Azure Foundry Agent SDK integration)
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id_here
AZURE_RESOURCE_GROUP_NAME=your_azure_resource_group_here
AZURE_AI_PROJECT_NAME=your_foundry_project_name_here

# ------------------------------------------------------------------------------
# 2. Azure AI Speech Services (Text-to-Speech & Speech-to-Text)
# ------------------------------------------------------------------------------
AZURE_SPEECH_ENDPOINT=https://<your-speech-resource-name>.cognitiveservices.azure.com/
AZURE_SPEECH_API_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ------------------------------------------------------------------------------
# 3. Embedding & Vector Store Settings
# ------------------------------------------------------------------------------
# Provider: 'azure_openai' (default production), 'local' (SentenceTransformers), or 'mock' (offline test)
EMBEDDING_PROVIDER=azure_openai
EMBEDDING_DIMENSION=3072
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store Backend: 'local' (in-memory + JSON persistence) or 'azure_search' (production)
VECTOR_STORE_BACKEND=local
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=your_azure_search_api_key_here
AZURE_SEARCH_INDEX_NAME=researchlens-chunks

# Hybrid Retrieval & BM25 Parameters
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# Chunking Configuration
CHUNK_TARGET_SIZE=650
CHUNK_OVERLAP=80
CHUNK_MIN_SIZE=120
CHUNK_MAX_SIZE=900

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8501
DEBUG=True
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_LANGUAGES=English,Hindi,French,Spanish
DEFAULT_LANGUAGE=English

# ------------------------------------------------------------------------------
# 5. Storage Paths (Relative to project root)
# ------------------------------------------------------------------------------
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTOR_DB_DIR=data/vector_store
